# Example only. Operator supplies real non-secret paths/origins and a separately provisioned secret FILE.
# Do not point these paths at an existing personal Birdclaw archive or shared X login.
BIRDCLAW_HOME=/var/lib/birdclaw-team/mentions
BIRDCLAW_TRIAGE_AUTH_HOME=/var/lib/birdclaw-team/auth
BIRDCLAW_TRIAGE_PROXY_TOKEN_FILE=/etc/birdclaw-team/proxy-token
BIRDCLAW_TRIAGE_PUBLIC_ORIGIN=https://mentions.example.net
BIRDCLAW_TRIAGE_TEAM_ORIGIN=https://team.example.net
BIRDCLAW_PORT=4317
BIRDCLAW_TRIAGE_ALLOW_HANDOFF=0
# Enable manual bounded X sync only AFTER the dedicated service account is provisioned and bound.
# BIRDCLAW_TRIAGE_SYNC_ACCOUNT=team-triage
# BIRDCLAW_XURL_OAUTH2_USERNAME=dedicated_x_handle
# BIRDCLAW_XURL_OAUTH2_APP=dedicated_read_app
# Optional separately authorized agent hook; disabled for Team users by default.
# BIRDCLAW_TRIAGE_ALLOW_HANDOFF=1
# BIRDCLAW_ROBOCLAW_HOOK_URL=https://private-gateway.example/hooks/agent
# BIRDCLAW_ROBOCLAW_HOOK_TOKEN is provisioned through the service secret manager, never this committed file.
